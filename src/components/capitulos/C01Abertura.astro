---
import Wordmark from '~/components/marca/Wordmark.astro';
import Adesivo from '~/components/marca/Adesivo.astro';
import Marquee from '~/components/ui/Marquee.astro';
import { site } from '~/data/site';
---
<section class="abertura capitulo papel" id="abertura" data-capitulo="abertura" data-tema="claro">
  <div class="env abertura-env">

    <div class="abertura-cabeca">
      <span class="label">Capítulo 01 — Abertura</span>
      <span class="label abertura-ano">Estúdio independente</span>
    </div>

    <div class="abertura-marca">
      <h1 class="so-leitor">CAROLIZE — {site.assinatura}</h1>
      <Wordmark animar fragmento comoTitulo class="abertura-wordmark" />
    </div>

    <div class="abertura-corpo">
      <p class="abertura-frase sub">
        Marcas têm histórias.<br />
        A gente transforma a maneira<br class="so-largo" /> como elas são contadas.
      </p>
      <p class="abertura-assinatura label">{site.assinatura}</p>
    </div>

    <a class="abertura-rolar" href="#marca" aria-label="Explorar a apresentação">
      <span class="label">Explore a apresentação</span>
      <span class="abertura-trilho" aria-hidden="true"><i></i></span>
    </a>

    <!-- intervenções do universo gráfico -->
    <Adesivo nome="estrela" tamanho={34} cor="var(--rosa)" giro={-8}
             class="ad ad--1" data-parallax="26" />
    <Adesivo nome="asterisco" tamanho={28} cor="var(--vinho)" giro={14}
             class="ad ad--2" data-parallax="-18" />
    <Adesivo nome="onda" tamanho={120} cor="var(--rosa)"
             class="ad ad--3" data-parallax="14" />
    <Adesivo nome="colcheteEsq" tamanho={18} cor="var(--preto)"
             class="ad ad--4" data-parallax="-10" />
  </div>

  <Marquee
    class="abertura-faixa"
    itens={['Estratégia', 'Identidade visual', 'Conteúdo', 'Direção de arte', 'Branding', 'Campanhas', 'Presença digital']}
    velocidade={52}
  />
</section>

<style>
  .abertura {
    min-height: 100svh;
    display: flex; flex-direction: column; justify-content: space-between;
    padding-block: clamp(4.5rem, 11vh, 7rem) 0;
    overflow: clip;
  }
  .abertura-env { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: clamp(1.6rem, 4vh, 3rem); position: relative; }

  .abertura-cabeca {
    display: flex; justify-content: space-between; gap: 1rem;
    padding-bottom: clamp(1rem, 3vh, 2rem);
    border-bottom: 1px solid var(--linha);
    animation: entra .8s var(--ease) .1s both;
  }
  .abertura-ano { color: var(--marca); }

  .abertura-marca { width: 100%; }
  .abertura-wordmark { width: 100%; }
  /* abre espaco para o indice lateral nao colidir com a palavra */
  @media (min-width: 64rem) { .abertura-wordmark { width: calc(100% - 7.5rem); } }

  .abertura-corpo {
    display: grid; grid-template-columns: 1fr auto; align-items: end;
    gap: clamp(1rem, 3vw, 3rem);
    animation: entra .9s var(--ease) 1.15s both;
  }
  .abertura-frase {
    max-width: 24ch; line-height: 1.2;
    font-variation-settings: 'opsz' 60, 'SOFT' 15, 'WONK' 0;
  }
  .abertura-assinatura { text-align: right; white-space: nowrap; }
  @media (max-width: 48rem) {
    .abertura-corpo { grid-template-columns: 1fr; align-items: start; }
    .abertura-assinatura { text-align: left; }
    .so-largo { display: none; }
  }

  .abertura-rolar {
    display: inline-flex; align-items: center; gap: .9rem;
    text-decoration: none; align-self: start; margin-top: clamp(.5rem, 2vh, 1.5rem);
    animation: entra .9s var(--ease) 1.4s both;
  }
  .abertura-trilho {
    position: relative; display: block; width: 3.4rem; height: 1px;
    background: var(--linha-forte); overflow: clip;
  }
  .abertura-trilho i {
    position: absolute; inset: 0 auto 0 0; width: 40%;
    background: var(--marca);
    animation: desliza 2.4s var(--ease) infinite;
  }
  .abertura-rolar:hover .abertura-trilho i { animation-duration: 1.2s; }

  .abertura-faixa {
    border-top: 1px solid var(--linha);
    padding-block: 1.05rem;
    font-family: var(--serif);
    font-variation-settings: 'opsz' 48, 'SOFT' 15;
    font-size: clamp(1.1rem, 2.1vw, 1.7rem);
    animation: entra 1s var(--ease) 1.6s both;
  }

  /* adesivos */
  .abertura :global(.ad) { position: absolute; translate: 0 var(--py, 0px); z-index: 1; }
  .abertura :global(.ad--1) { top: 4%; right: 2%; }
  .abertura :global(.ad--2) { bottom: 16%; right: 13%; }
  .abertura :global(.ad--3) { top: 30%; left: -3%; opacity: .5; }
  .abertura :global(.ad--4) { top: 46%; left: -1.6%; opacity: .3; }
  @media (max-width: 48rem) {
    .abertura :global(.ad--3), .abertura :global(.ad--4) { display: none; }
    .abertura :global(.ad--2) { bottom: 22%; right: 4%; }
  }

  @keyframes entra { from { opacity: 0; translate: 0 1rem; } to { opacity: 1; translate: 0 0; } }
  @keyframes desliza {
    0% { translate: -110% 0; } 55%, 100% { translate: 260% 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .abertura-cabeca, .abertura-corpo, .abertura-rolar, .abertura-faixa { animation: none; }
    .abertura-trilho i { animation: none; translate: 0; }
  }
</style>

<script>
  // dispara a animação de entrada da logo só depois das fontes resolverem,
  // para que as letras não saltem de posição no meio do movimento
  const wm = document.querySelector('.abertura-wordmark');
  const tocar = () => wm?.classList.add('tocar');
  if (document.fonts?.ready) document.fonts.ready.then(tocar).catch(tocar);
  else tocar();
  setTimeout(tocar, 1200);
</script>
