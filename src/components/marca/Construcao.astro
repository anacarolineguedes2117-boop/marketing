---
/**
 * Diagrama de construcao do simbolo: a geometria exposta.
 * Os valores vem dos mesmos parametros que geram a marca (tools/geometry.py),
 * entao o desenho nunca descreve algo diferente do que esta publicado.
 */
import { brand } from '~/lib/brand-paths';
const { symbol } = brand;
const R: number = symbol.r;  // 50
const stress = -38;          // eixo de afinamento
const rad = (stress * Math.PI) / 180;
const ox = 6 * Math.cos(rad), oy = 6 * Math.sin(rad);
const gap = 26;
const pt = (a: number, r: number = R) => [r * Math.cos((a * Math.PI) / 180), r * Math.sin((a * Math.PI) / 180)];
const [gx1, gy1] = pt(stress + gap, R * 1.34);
const [gx2, gy2] = pt(stress - gap, R * 1.34);
const [ex, ey] = pt(stress, R * 1.5);
---
<figure class="constr">
  <svg viewBox="-86 -86 172 172" role="img" aria-label="Diagrama de construção do símbolo CAROLIZE">
    <title>Construção do símbolo</title>
    <path d={symbol.ring} class="forma" />
    <path d={symbol.frag} class="frag" />
    {/* as guias ficam por cima: a construcao precisa ser lida sobre a forma */}
    <g class="guias">
      <circle cx="0" cy="0" r={R} />
      <circle cx={ox} cy={oy} r={32} />
      <line x1={-ex} y1={-ey} x2={ex} y2={ey} class="eixo" />
      <line x1="0" y1="0" x2={gx1} y2={gy1} />
      <line x1="0" y1="0" x2={gx2} y2={gy2} />
      <circle cx="0" cy="0" r="1.6" class="centro" />
      <circle cx={ox} cy={oy} r="1.6" class="centro" />
    </g>
    <g class="cotas">
      <text x={ex * 0.9} y={ey * 0.9 - 7}>52°</text>
      <text x={-R - 17} y="4">R</text>
      <text x={ox - 48} y={oy + 54}>r</text>
    </g>
  </svg>
  <figcaption class="label">
    Círculo externo R. Círculo interno r, deslocado 12% de R no eixo de −38°.
    A diferença entre os dois gera o contraste de espessura. Abertura de 52°
    no ponto mais fino.
  </figcaption>
</figure>
<style>
  .constr { margin: 0; display: grid; gap: 1.2rem; }
  .constr svg { width: 100%; height: auto; overflow: visible; }
  .guias { fill: none; stroke: var(--marca); stroke-width: .7; opacity: .78; }
  .guias .eixo { stroke-dasharray: 3 3; }
  .guias .centro { fill: var(--marca); stroke: none; opacity: 1; }
  .forma { fill: var(--tinta); }
  .frag { fill: var(--marca); }
  .cotas text {
    font-family: var(--mono); font-size: 7px; fill: var(--tinta-3);
    text-anchor: middle; dominant-baseline: middle;
  }
  .constr figcaption { max-width: 44ch; line-height: 1.7; text-transform: none; letter-spacing: .01em; }
</style>
