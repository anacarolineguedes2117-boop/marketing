---
import Peca from './Peca.astro';
import CarimboConceitual from './CarimboConceitual.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projeto: CollectionEntry<'projetos'>;
  indice?: number;
  class?: string;
  /** Nivel do titulo: 2 numa pagina de listagem, 3 dentro de um capitulo. */
  nivel?: 2 | 3;
}
const { projeto, indice = 0, class: klass = '', nivel = 3, ...resto } = Astro.props;
const Titulo = `h${nivel}` as 'h2' | 'h3';
const d = projeto.data;
const cores = d.paleta.map((c) => c.hex);
const tinta = d.paleta.find((c) => c.tinta)?.hex ?? d.paleta[0]!.hex;
const fundo = d.paleta.find((c) => !c.tinta)?.hex ?? '#ffffff';
const claro = [...d.paleta].sort((a, b) => lum(b.hex) - lum(a.hex))[0]!.hex;
const acento = cores.find((c) => c !== tinta && c !== claro) ?? cores[1]!;

function lum(hex: string) {
  const n = parseInt(hex.slice(1), 16);
  return 0.2126 * ((n >> 16) & 255) + 0.7152 * ((n >> 8) & 255) + 0.0722 * (n & 255);
}
const paletaPeca = [claro, tinta, acento, fundo];
---
<article class:list={['proj', klass]} style={`--i:${indice}`} {...resto}>
  <a class="proj-link" href={`/projetos/${projeto.id}`}>
    <span class="so-leitor">Ver o estudo {d.titulo}</span>
  </a>

  <div class="proj-visual">
    <Peca
      tipo="post" marca={d.marca} cores={paletaPeca}
      frase={d.frase ?? d.titulo}
      rotuloInterno={d.segmento}
      class="proj-peca"
    />
    {d.conceitual && <CarimboConceitual class="proj-carimbo" tamanho={86} cor={tinta} />}
  </div>

  <div class="proj-info">
    <div class="proj-meta">
      <span class="label">{String(indice + 1).padStart(2, '0')}</span>
      <span class="label">{d.segmento}</span>
    </div>
    <Titulo class="proj-titulo">{d.titulo}</Titulo>
    <p class="proj-resumo">{d.resumo}</p>
    <div class="proj-paleta" aria-hidden="true">
      {d.paleta.map((c) => <span style={`background:${c.hex}`} title={c.nome}></span>)}
    </div>
    <span class="proj-cta label">Ver o estudo <i aria-hidden="true">→</i></span>
  </div>
</article>

<style>
  .proj {
    position: relative;
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.4rem, 4vw, 4rem);
    align-items: center;
    padding-block: clamp(2rem, 5vh, 3.4rem);
    border-top: 1px solid var(--linha);
  }
  .proj:last-of-type { border-bottom: 1px solid var(--linha); }
  .proj:nth-child(even) .proj-visual { order: 2; }

  .proj-link { position: absolute; inset: 0; z-index: 3; }
  .proj-link:focus-visible { outline-offset: -4px; }

  .proj-visual { position: relative; }
  .proj-visual :global(.proj-peca) {
    width: min(100%, 27rem);
    transition: rotate .6s var(--ease);
  }
  .proj:nth-child(even) .proj-visual :global(.proj-peca) { margin-left: auto; }
  .proj:hover .proj-visual :global(.proj-peca) { rotate: -1.4deg; }

  .proj-visual :global(.proj-carimbo) {
    position: absolute; right: -1.1rem; bottom: -1.1rem; z-index: 2;
    background: var(--bg); border-radius: 50%;
  }
  .proj:nth-child(even) .proj-visual :global(.proj-carimbo) { right: auto; left: -1.1rem; }
  @media (max-width: 54rem) {
    .proj-visual :global(.proj-carimbo) { right: 0; bottom: -1rem; width: 62px; height: 62px; }
    .proj:nth-child(even) .proj-visual :global(.proj-carimbo) { left: auto; right: 0; }
  }

  .proj-info { display: grid; gap: .9rem; justify-items: start; }
  .proj-meta { display: flex; gap: 1.2rem; align-items: baseline; }
  .proj-titulo {
    font-family: var(--serif); font-variation-settings: 'opsz' 144, 'SOFT' 15;
    font-size: clamp(2rem, 4.6vw, 3.4rem); font-weight: 500;
    line-height: 1; letter-spacing: -.025em; margin: 0;
  }
  .proj-resumo {
    font-size: var(--t-peq); line-height: 1.64; color: var(--tinta-2);
    max-width: 40ch; margin: 0; text-wrap: pretty;
  }
  .proj-paleta { display: flex; gap: 0; margin-top: .3rem; }
  .proj-paleta span {
    width: 1.65rem; height: 1.65rem; display: block;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / .07);
  }
  .proj-cta {
    display: inline-flex; align-items: center; gap: .55rem;
    color: var(--tinta); margin-top: .5rem;
    border-bottom: 1px solid var(--linha-forte); padding-bottom: .35rem;
  }
  .proj-cta i { font-style: normal; transition: translate .34s var(--ease); }
  .proj:hover .proj-cta i { translate: .3rem 0; }

  @media (max-width: 54rem) {
    .proj { grid-template-columns: 1fr; gap: 1.8rem; }
    .proj:nth-child(even) .proj-visual { order: 0; }
    .proj-visual :global(.proj-peca) { width: min(100%, 18rem); }
    .proj:nth-child(even) .proj-visual :global(.proj-peca) { margin-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .proj-visual :global(.proj-peca), .proj-cta i { transition: none; }
    .proj:hover .proj-visual :global(.proj-peca) { rotate: 0deg; }
  }
</style>
