---
/**
 * CAROLIZE — apresentação de marca.
 *
 * A identidade da Carolize mostrada como um projeto entregue a um cliente:
 * o que compõe o pacote, como cada peça foi decidida e como tudo se aplica.
 * Serve de portfólio e de amostra do que o cliente recebe.
 */
import Base from '~/layouts/Base.astro';
import Revelar from '~/components/ui/Revelar.astro';
import TextoRevelado from '~/components/ui/TextoRevelado.astro';
import Wordmark from '~/components/marca/Wordmark.astro';
import Simbolo from '~/components/marca/Simbolo.astro';
import Selo from '~/components/marca/Selo.astro';
import Adesivo from '~/components/marca/Adesivo.astro';
import Construcao from '~/components/marca/Construcao.astro';
import Peca from '~/components/pecas/Peca.astro';
import Template from '~/components/pecas/Template.astro';
import Botao from '~/components/ui/Botao.astro';
import Marquee from '~/components/ui/Marquee.astro';
import Rosca from '~/components/dados/Rosca.astro';
import Barras from '~/components/dados/Barras.astro';
import Escala from '~/components/dados/Escala.astro';
import { adesivos } from '~/lib/stickers';
import { versoes, paleta, regras, tipografia } from '~/data/marca';
import { numeros, pacote, proporcaoPaleta, etapasMarca, criteriosNome, usosIncorretos } from '~/data/showcase';
import { contraste } from '~/lib/cores';
import { rotulosPeca, type TipoPeca } from '~/components/pecas/tipos';
import type { NomeAdesivo } from '~/lib/stickers';

const marcaCarolize = {
  texto: 'CAROLIZE', familia: 'serif' as const, peso: 600,
  tracking: 0.046, caixaAlta: true, assinatura: 'por Carol Guedes',
};
const coresPeca = ['#FFF9F5', '#242424', '#D77D91', '#F7EFE9'];
const pecasMostradas: TipoPeca[] = [
  'cartao', 'cartaoVerso', 'papelaria', 'etiqueta', 'embalagem',
  'catalogo', 'tela', 'destaques', 'assinaturaEmail',
];
const nomesAdesivos = Object.keys(adesivos) as NomeAdesivo[];

function tamanhoNaGrade(vb: string) {
  const [, , l, a] = vb.split(' ').map(Number);
  return a! > l! ? `${((64 * l!) / a!).toFixed(1)}%` : '64%';
}

/** Contraste real de cada cor contra a superfície creme. */
const contrastes = paleta
  .filter((c) => c.hex !== '#FFF9F5')
  .map((c) => ({
    nome: c.nome,
    cor: c.hex,
    valor: Number(contraste(c.hex, '#FFF9F5').toFixed(2)),
    nota: contraste(c.hex, '#FFF9F5') >= 4.5
      ? 'Aprovado para texto pequeno'
      : contraste(c.hex, '#FFF9F5') >= 3
        ? 'Só para título grande ou elemento gráfico'
        : 'Não serve como texto — apenas forma',
    sufixo: ':1',
  }))
  .sort((a, b) => b.valor - a.valor);

/** Grade de feed: nove posts que precisam funcionar juntos. */
const feed = [
  { tipo: 'citacao' as const, titulo: 'Marcas têm histórias' },
  { tipo: 'numero' as const, numero: '01', titulo: 'Comece pelo conceito' },
  { tipo: 'retrato' as const },
  { tipo: 'anuncio' as const, titulo: 'Sua marca merece um sistema', texto: 'Fale comigo' },
  { tipo: 'capaCarrossel' as const, numero: '03', titulo: 'Três erros de identidade' },
  { tipo: 'citacao' as const, titulo: 'Bonito sem direção é decoração' },
  { tipo: 'dica' as const, titulo: 'Antes de publicar', itens: ['Qual o objetivo', 'Para quem', 'O que fica depois'] },
  { tipo: 'retrato' as const },
  { tipo: 'numero' as const, numero: '05', titulo: 'Etapas até a entrega' },
];
---
<Base
  titulo="A marca — apresentação completa"
  descricao="A identidade visual da CAROLIZE apresentada como projeto: conceito, logo, paleta, tipografia, universo gráfico, templates e aplicações. O que você recebe num projeto de branding."
  classe="pagina-marca"
>
  <!-- ══════════════════════════════════ 00 · abertura -->
  <header class="ab papel" data-tema="claro">
    <div class="env">
      <p class="ab-topo label">
        <span>Apresentação de marca</span>
        <span>CAROLIZE por CAROLIZE</span>
      </p>

      <h1 class="cartaz ab-h">
        <span>Identidade</span>
        <span>visual <em>completa</em></span>
      </h1>

      <div class="ab-base">
        <p class="lede">
          Esta página é um projeto de branding apresentado do começo ao fim —
          e o cliente fui eu. Tudo que você vê aqui é o que entrego:
          conceito, logo, cor, tipografia, templates e manual.
        </p>
        <Selo class="ab-selo" tamanho={132} cor="var(--vinho)" acento="var(--rosa)" />
      </div>

      <ul class="ab-numeros">
        {numeros.map((n) => (
          <li>
            <span class="ab-n num">{n.valor}</span>
            <span class="ab-r">{n.rotulo}</span>
            <span class="ab-o">{n.nota}</span>
          </li>
        ))}
      </ul>

      <Adesivo nome="brilho" tamanho={34} cor="var(--rosa)" class="ab-ad" giro={14} />
    </div>
  </header>

  <Marquee
    class="faixa" velocidade={58}
    itens={['Conceito', 'Naming', 'Logo', 'Paleta', 'Tipografia', 'Universo gráfico', 'Templates', 'Aplicações', 'Manual']}
  />

  <!-- ══════════════════════════════════ 01 · o pacote -->
  <section class="sec sec--vinho" id="pacote" data-tema="vinho">
    <div class="env">
      <header class="cab">
        <span class="label">01</span>
        <span class="label">O que você recebe</span>
      </header>
      <TextoRevelado como="h2" class="cartaz sec-h" texto="Um sistema, não um arquivo." />
      <Revelar modo="sobe"><p class="lede sec-lede">
        Uma logo sozinha não sustenta uma marca. O que resolve é o conjunto:
        as regras, os limites e os modelos que fazem tudo continuar coerente
        quando você publica sem mim.
      </p></Revelar>

      <ol class="pacote">
        {pacote.map((p, i) => (
          <Revelar modo="sobe" atraso={(i % 4) * 0.04} como="li" class="pct">
            <div class="pct-topo">
              <span class="pct-n label">{p.n}</span>
              <Adesivo nome={p.adesivo as NomeAdesivo} tamanho={26} cor="var(--acento)" giro={i % 2 ? 7 : -7} />
            </div>
            <h3 class="pct-nome">{p.nome}</h3>
            <p class="pct-desc">{p.descricao}</p>
            <ul class="pct-itens">{p.itens.map((it) => <li>{it}</li>)}</ul>
          </Revelar>
        ))}
      </ol>
    </div>
  </section>

  <!-- ══════════════════════════════════ 02 · o caso -->
  <section class="sec" id="caso" data-tema="claro">
    <div class="env">
      <header class="cab"><span class="label">02</span><span class="label">O caso</span></header>
      <div class="caso">
        <div>
          <TextoRevelado como="h2" class="titulo" texto="Meu primeiro cliente fui eu." />
          <Revelar modo="sobe" atraso={0.08} class="caso-txt">
            <p class="corpo">
              Um estúdio de marca que não resolve a própria identidade está
              pedindo confiança sem dar prova. Então tratei a Carolize como
              trataria qualquer cliente: briefing, conceito, rodadas de ajuste
              e manual no fim.
            </p>
            <p class="corpo">
              O desafio era específico. Marketing digital independente disputa
              atenção com dois extremos — o freelancer que mostra artes soltas
              e a agência que fala em linguagem corporativa. Os dois são
              esquecíveis pelo mesmo motivo: <strong>não têm ponto de vista</strong>.
            </p>
          </Revelar>
        </div>
        <Revelar modo="escala" atraso={0.1} class="caso-briefing">
          <p class="label">O briefing</p>
          <dl>
            <div><dt>Marca</dt><dd>CAROLIZE</dd></div>
            <div><dt>Segmento</dt><dd>Marketing digital e branding</dd></div>
            <div><dt>Desafio</dt><dd>Parecer estúdio criativo, não prestador de serviço</dd></div>
            <div><dt>Personalidade</dt><dd>Elegante, feminina, contemporânea — nunca infantil</dd></div>
            <div><dt>Restrição</dt><dd>Rosa como assinatura, nunca como superfície</dd></div>
          </dl>
        </Revelar>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════ 03 · naming -->
  <section class="sec sec--papel" id="naming" data-tema="papel">
    <div class="env">
      <header class="cab"><span class="label">03</span><span class="label">Naming</span></header>
      <div class="naming">
        <Revelar modo="escala" class="eq">
          <div class="eq-l"><span class="eq-p">CAROL</span><span class="eq-nota label">o nome</span></div>
          <div class="eq-l eq-l--2">
            <span class="eq-op" aria-hidden="true">+</span>
            <span class="eq-p eq-p--ac">IZE</span>
            <span class="eq-nota label">o sufixo que vira verbo</span>
          </div>
          <Adesivo nome="rabisco" tamanho="70%" cor="var(--marca)" class="eq-risco" />
          <div class="eq-l"><span class="eq-op" aria-hidden="true">=</span><span class="eq-res">TRANSFORMAR</span></div>
        </Revelar>

        <div class="criterios">
          <Revelar modo="sobe"><h3 class="sub">Os quatro critérios</h3></Revelar>
          <ol>
            {criteriosNome.map((c, i) => (
              <Revelar modo="sobe" atraso={i * 0.05} como="li">
                <span class="cr-n num">{String(i + 1).padStart(2, '0')}</span>
                <span class="cr-c">{c.c}</span>
                <span class="cr-nota">{c.nota}</span>
              </Revelar>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════ 04 · símbolo -->
  <section class="sec sec--preto" id="simbolo" data-tema="escuro">
    <div class="env">
      <header class="cab"><span class="label">04</span><span class="label">O símbolo</span></header>
      <div class="simb">
        <div>
          <TextoRevelado como="h2" class="cartaz sec-h" texto="Um O que se abre em C." />
          <Revelar modo="sobe" atraso={0.08} class="simb-txt">
            <p class="corpo">
              O conceito virou geometria. Um anel completo que se abre e deixa
              escapar um fragmento — a marca em estado de transformação.
            </p>
            <p class="corpo">
              A espessura não é constante: o círculo interno é deslocado num
              eixo diagonal, o que reproduz o <strong>contraste de espessura</strong>
              das serifas clássicas numa forma puramente geométrica. É isso que
              faz o símbolo conversar com a tipografia sem copiá-la.
            </p>
          </Revelar>
          <Revelar modo="sobe" atraso={0.14} class="simb-reducao">
            <p class="label">Redução — o que sobrevive em cada tamanho</p>
            <div class="esc">
              <div><Simbolo tamanho={76} cor="var(--creme)" /><span class="label">76px</span></div>
              <div><Simbolo tamanho={44} cor="var(--creme)" /><span class="label">44px</span></div>
              <div><Simbolo tamanho={28} fragmento={false} cor="var(--creme)" /><span class="label">28px</span></div>
              <div><Simbolo tamanho={16} fragmento={false} cor="var(--creme)" /><span class="label">16px</span></div>
            </div>
            <p class="g-nota">Abaixo de 40px o fragmento vira sujeira. A versão reduzida sai sem ele.</p>
          </Revelar>
        </div>
        <Revelar modo="escala" atraso={0.1}><Construcao /></Revelar>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════ 05 · logo -->
  <section class="sec" id="logo" data-tema="claro">
    <div class="env">
      <header class="cab"><span class="label">05</span><span class="label">A logo</span></header>
      <Revelar modo="fade" class="logo-palco"><Wordmark fragmento class="logo-grande" /></Revelar>
      <Revelar modo="sobe"><p class="lede sec-lede">
        Oito arquivos vetoriais. Cada um existe porque há um contexto em que
        só ele funciona. Clique para baixar.
      </p></Revelar>

      <div class="versoes">
        {versoes.map((v, i) => (
          <Revelar modo="escala" atraso={(i % 4) * 0.04} class="ver" como="figure">
            <a href={`/brand/${v.arquivo}`} download class={`ver-caixa ver-caixa--${v.fundo ?? 'claro'}`}>
              <img src={`/brand/${v.arquivo}`} alt={`Logo CAROLIZE — versão ${v.nome}`} loading="lazy" />
            </a>
            <figcaption>
              <span class="ver-nome">{v.nome}</span>
              <span class="ver-nota">{v.nota}</span>
              <span class="ver-link label">Baixar SVG ↓</span>
            </figcaption>
          </Revelar>
        ))}
      </div>

      <div class="regras">
        <Revelar modo="sobe" class="reg">
          <h3 class="sub">Sempre</h3>
          <ul class="reg-sim">{regras.certo.map((r) => <li>{r}</li>)}</ul>
        </Revelar>
        <Revelar modo="sobe" atraso={0.06} class="reg">
          <h3 class="sub">Nunca</h3>
          <div class="erros">
            {/* só a demonstração de cor precisa do SVG inline (currentColor);
                as demais reusam o arquivo já publicado, sem duplicar as curvas
                da tipografia oito vezes no DOM */}
            {usosIncorretos.map((u) => (
              <figure class={`erro erro--${u.id}`}>
                <span class="erro-palco">
                  {u.id === 'recolorir'
                    ? <Wordmark class="erro-marca" />
                    : u.id === 'refonte'
                      ? null
                      : <img class="erro-marca" src="/brand/carolize-wordmark.svg" alt="" width="430" height="110" loading="lazy" />}
                </span>
                <figcaption class="label">{u.rotulo}</figcaption>
              </figure>
            ))}
          </div>
        </Revelar>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════ 06 · paleta -->
  <section class="sec sec--papel" id="cor" data-tema="papel">
    <div class="env">
      <header class="cab"><span class="label">06</span><span class="label">Paleta</span></header>
      <TextoRevelado como="h2" class="cartaz sec-h" texto="Cinco cores. Papéis fixos." />

      <div class="cores">
        {paleta.map((c, i) => (
          <Revelar modo="sobe" atraso={(i % 3) * 0.04} class="cor" como="article">
            <span class="cor-bloco" style={`background:${c.hex}`}></span>
            <span class="label cor-papel">{c.papel}</span>
            <h3 class="cor-nome">{c.nome}</h3>
            <p class="cor-hex label">{c.hex.toUpperCase()}</p>
            <p class="cor-uso">{c.uso}</p>
          </Revelar>
        ))}
      </div>

      <div class="graficos">
        <Revelar modo="sobe" class="cartao-g" data-tema="claro">
          <Rosca
            titulo="Proporção de uso"
            fatias={proporcaoPaleta}
            nota="Regra de aplicação, não medição. O creme domina porque é a superfície; o rosa aparece pouco de propósito — é assinatura, não fundo."
          />
        </Revelar>
        <Revelar modo="sobe" atraso={0.08} class="cartao-g" data-tema="claro">
          <Barras
            titulo="Contraste sobre o creme"
            itens={contrastes}
            referencia={{ em: 4.5, rotulo: '4,5:1 mínimo' }}
            nota="Valores calculados, não estimados. O rosa não alcança o mínimo para texto pequeno — por isso ele nunca carrega texto sobre fundo claro; esse papel é do vinho."
          />
        </Revelar>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════ 07 · tipografia -->
  <section class="sec sec--vinho" id="tipografia" data-tema="vinho">
    <div class="env">
      <header class="cab"><span class="label">07</span><span class="label">Tipografia</span></header>
      <TextoRevelado como="h2" class="cartaz sec-h" texto="Três vozes que não se atropelam." />

      <div class="tipos">
        {tipografia.map((t, i) => (
          <Revelar modo="sobe" atraso={i * 0.05} class="tipo" como="article">
            <div class="tipo-cab">
              <h3 class="tipo-nome">{t.familia}</h3>
              <span class="label">{t.papel}</span>
            </div>
            <p class={`tipo-amostra ${t.classe}`}>{t.amostra}</p>
            <div class="tipo-rodape">
              <p class="tipo-desc">{t.descricao}</p>
              <p class="label tipo-lic">{t.licenca}</p>
            </div>
          </Revelar>
        ))}
      </div>

      <Revelar modo="sobe" class="cartao-g cartao-g--largo" data-tema="claro"><Escala /></Revelar>
    </div>
  </section>

  <!-- ══════════════════════════════════ 08 · universo gráfico -->
  <section class="sec" id="universo" data-tema="claro">
    <div class="env">
      <header class="cab"><span class="label">08</span><span class="label">Universo gráfico</span></header>
      <TextoRevelado como="h2" class="cartaz sec-h" texto="Vinte peças que só são suas." />
      <Revelar modo="sobe"><p class="lede sec-lede">
        Adesivos, carimbos, recortes e rabiscos desenhados para esta marca.
        Entram em post, apresentação, embalagem e site — sempre em dose pequena:
        são pontuação, não enfeite.
      </p></Revelar>
      <div class="universo">
        {nomesAdesivos.map((n, i) => (
          <Revelar modo="escala" atraso={(i % 6) * 0.025} class="ad-item" como="figure">
            <span class="ad-caixa">
              <Adesivo
                nome={n} tamanho={tamanhoNaGrade(adesivos[n].vb)}
                cor={i % 3 === 0 ? 'var(--marca)' : i % 3 === 1 ? 'var(--vinho)' : 'var(--preto)'}
              />
            </span>
            <figcaption class="label">{n}</figcaption>
          </Revelar>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════ 09 · templates -->
  <section class="sec sec--papel" id="templates" data-tema="papel">
    <div class="env">
      <header class="cab"><span class="label">09</span><span class="label">Templates</span></header>
      <TextoRevelado como="h2" class="cartaz sec-h" texto="Modelos para você publicar sozinha." />
      <Revelar modo="sobe"><p class="lede sec-lede">
        A parte que mais economiza tempo depois da entrega. Cada modelo já tem
        margem, hierarquia e cor definidas — você troca o texto e publica.
      </p></Revelar>

      <div class="tpl-bloco">
        <Revelar modo="sobe" class="tpl-feed-col">
          <p class="label tpl-rot">Grade de feed — nove posts que precisam funcionar juntos</p>
          <div class="feed">
            {feed.map((f) => (
              <Template
                tipo={f.tipo}
                titulo={f.titulo ?? 'Carolize'}
                numero={f.numero}
                itens={f.itens}
                texto={f.texto}
                etiqueta="carolize"
                class="feed-cel"
              />
            ))}
          </div>
          <p class="g-nota">
            O feed é lido como uma imagem só. Por isso os modelos alternam peso:
            claro, escuro, cheio e vazio — nunca três posts iguais em sequência.
          </p>
        </Revelar>

        <Revelar modo="sobe" atraso={0.08} class="tpl-stories-col">
          <p class="label tpl-rot">Stories</p>
          <div class="stories">
            <Template tipo="storyCapa" titulo="Três erros de identidade visual" etiqueta="novo" rotulo="Capa" />
            <Template tipo="storyCitacao" titulo="Bonito sem direção é decoração." etiqueta="carolize" adesivo="estrela" rotulo="Citação" />
            <Template tipo="storyEnquete" titulo="Sua marca tem manual?" itens={['Tem', 'Ainda não']} etiqueta="carolize" rotulo="Enquete" />
            <Template tipo="storyBastidor" titulo="Rodada de ajuste do símbolo — o fragmento mudou três vezes." etiqueta="bastidores" rotulo="Bastidor" />
          </div>
        </Revelar>
      </div>

      <Revelar modo="sobe" class="tpl-posts">
        <p class="label tpl-rot">Modelos de post, isolados</p>
        <div class="posts">
          <Template tipo="citacao" titulo="Marcas têm histórias." etiqueta="carolize" rotulo="Citação" />
          <Template tipo="anuncio" titulo="Sua marca merece um sistema." texto="Fale comigo" etiqueta="serviço" rotulo="Anúncio" />
          <Template tipo="dica" titulo="Antes de publicar" itens={['Qual é o objetivo', 'Para quem é', 'O que fica depois']} etiqueta="dica rápida" rotulo="Lista" />
          <Template tipo="capaCarrossel" numero="03" titulo="Três erros de identidade" rotulo="Capa de carrossel" />
        </div>
      </Revelar>
    </div>
  </section>

  <!-- ══════════════════════════════════ 10 · aplicações -->
  <section class="sec" id="aplicacoes" data-tema="claro">
    <div class="env">
      <header class="cab"><span class="label">10</span><span class="label">Aplicações</span></header>
      <TextoRevelado como="h2" class="cartaz sec-h" texto="A marca fora da tela." />
      <Revelar modo="sobe"><p class="lede sec-lede">
        O mesmo sistema atravessando impresso, embalagem e assinatura. Todas as
        peças são construídas com os mesmos tokens do site — trocar uma cor
        redesenha o conjunto inteiro.
      </p></Revelar>
      <div class="aplic">
        {pecasMostradas.map((t, i) => (
          <Revelar modo="escala" atraso={(i % 3) * 0.04} class={`ap ap--${t}`}>
            <Peca
              tipo={t} marca={marcaCarolize} cores={coresPeca}
              rotulo={rotulosPeca[t]}
              frase="Marcas têm histórias. A gente transforma a maneira como elas são contadas."
              giro={i % 4 === 2 ? -1.1 : i % 4 === 3 ? 0.9 : 0}
            />
          </Revelar>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════ 11 · processo -->
  <section class="sec sec--preto" id="processo" data-tema="escuro">
    <div class="env">
      <header class="cab"><span class="label">11</span><span class="label">Como acontece</span></header>
      <TextoRevelado como="h2" class="cartaz sec-h" texto="Cinco etapas até a entrega." />
      <ol class="trilha">
        {etapasMarca.map((e, i) => (
          <Revelar modo="sobe" atraso={i * 0.05} como="li" class="tr-etapa" style={`--i:${i}`}>
